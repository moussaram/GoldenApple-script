{
  "manifest_version": 3,
  "name": "GoldenApple Engine",
  "version": "2.1.0",
  "description": "Moteur autonome local de détection et d'analyse Apple of Fortune",
  "host_permissions": [
    "*://*.1xbet.com/*",
    "*://*.melbet.com/*",
    "*://*.winwin.com/*",
    "*://winwin-17094.pro/*",
    "*://*.winwin-17094.pro/*",
    "*://*.megapari.com/*",
    "*://*.1xgame.com/*",
    "*://*.1xslot.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.1xbet.com/*",
        "*://*.melbet.com/*",
        "*://*.winwin.com/*",
        "*://winwin-17094.pro/*",
        "*://*.winwin-17094.pro/*",
        "*://*.megapari.com/*",
        "*://*.1xgame.com/*",
        "*://*.1xslot.com/*"
      ],
      "js": [
        "core/analyzer.js",
        "core/detector.js",
        "core/predictor.js",
        "ui/overlay.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui/overlay.css"
      ],
      "matches": [
        "*://*.1xbet.com/*",
        "*://*.melbet.com/*",
        "*://*.winwin.com/*",
        "*://winwin-17094.pro/*",
        "*://*.winwin-17094.pro/*",
        "*://*.megapari.com/*",
        "*://*.1xgame.com/*",
        "*://*.1xslot.com/*"
      ]
    }
  ]
}
